# ============================================================
# Lintas Waktu API — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# ADMIN AUTH
# ------------------------------------------------------------
# Password to access the admin dashboard
ADMIN_PASSWORD=changeme123

# Secret key for JWT signing — generate a strong random string!
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Token expiry in minutes (default: 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# SQLite (recommended for local development)
DATABASE_URL=sqlite:///./photo_platform.db

# PostgreSQL (recommended for production / Railway / Render)
# DATABASE_URL=postgresql://user:password@localhost:5432/photo_platform

# ------------------------------------------------------------
# GOOGLE DRIVE — pick ONE (see README.md)
# ------------------------------------------------------------
# Option 1 (simplest): API key + folder shared as "Anyone with the link"
GOOGLE_API_KEY=

# Option 2: Service Account JSON key file (private folders shared to its email)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ------------------------------------------------------------
# CORS / APP URLS
# ------------------------------------------------------------
# URL of your frontend (CORS whitelist + generated gallery links)
FRONTEND_URL=http://localhost:3000

# Days to keep image cache for completed sessions
CACHE_RETENTION_DAYS=30

# Environment: development | production
APP_ENV=development

# Shared secret with the website (web/.env.local REVALIDATE_SECRET) so admin edits
# show on the site immediately instead of after its 60 s cache. Optional.
REVALIDATE_SECRET=
